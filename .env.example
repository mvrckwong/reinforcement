# General
PYTHONWARNINGS=ignore::DeprecationWarning

# S3/MinIO Storage Configuration (required for S3 uploads)
S3_ENDPOINT_URL=https://localhost:9000
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=us-east-1
S3_BUCKET_NAME=artifacts

# Phemex API Configuration
PHEMEX_API_KEY=your-phemex-api-key
PHEMEX_API_SECRET=your-phemex-api-secret

# Logging Configuration (optional, defaults shown)
LOG_LEVEL=INFO
LOG_RETENTION=7 days
LOG_SERIALIZE=false

# FRED API Configuration
FRED_API_KEY=your-fred-api-key

# Alpha Vantage API Configuration
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key